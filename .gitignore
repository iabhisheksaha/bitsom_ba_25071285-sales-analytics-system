# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# Credentials — NEVER commit these
config/credentials.enc
*.key
.env
.env.*

# Browser profile — contains live LinkedIn/Naukri session cookies. NEVER commit.
browser_profile/
**/browser_profile/

# Tailored resumes (generated at runtime)
resume/tailored/*.docx

# Runtime logs (optional — remove if you want to track application history)
logs/applications.json
logs/discovered_jobs.json
logs/reports/
logs/debug/
logs/scheduler.log

# Test artefacts generated by mock_run.py
logs/test_*.json
logs/test_credentials.enc

# IDE
.idea/
.vscode/
*.swp
